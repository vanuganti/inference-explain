# Copy to .env (never commit .env). Real shell environment variables override .env.

# Provider selection: openai | gemini | anthropic
EXPLAIN_PROVIDER=openai

# Reasoning effort for all providers: minimal | low | medium | high (blank = provider default)
REASONING_EFFORT=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Common
EXPLAIN_AGENT_DB=.explain-agent/runtime.db
EXPLAIN_AGENT_BUDGET_USD=2.00
# Separate stores: the local payment service and persistent agent memory
EXPLAIN_PAYMENTS_DB=.explain-agent/payments.db
EXPLAIN_MEMORY_DB=.explain-agent/memory.db

# Pricing, USD per 1M tokens. No prices are built in (they change); without
# them Cost renders UNAVAILABLE. Optional cached/reasoning overrides:
#   *_CACHED_PER_M defaults to the input price, reasoning is billed as output.
OPENAI_PRICE_INPUT_PER_M=
OPENAI_PRICE_OUTPUT_PER_M=
OPENAI_PRICE_CACHED_PER_M=
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=
GEMINI_PRICE_CACHED_PER_M=
ANTHROPIC_PRICE_INPUT_PER_M=
ANTHROPIC_PRICE_OUTPUT_PER_M=
ANTHROPIC_PRICE_CACHED_PER_M=
