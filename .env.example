# Copy to .env (never commit .env). Real shell environment variables override .env.

# Provider selection: openai | gemini | anthropic
EXPLAIN_PROVIDER=openai

# Reasoning effort for all providers: minimal | low | medium | high (blank = provider default)
REASONING_EFFORT=

# Models: *_MODELS is a comma list; each entry has an optional :tier of small|standard|frontier (default standard).
# One model is just a name. The plan (example 06) picks among all of them; other examples use the first.
# OpenAI
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.2:frontier

# Gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest:standard

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5:standard,claude-haiku-4-5-20251001:small,claude-opus-5-5:frontier

# Common
EXPLAIN_AGENT_DB=.explain-agent/runtime.db
EXPLAIN_AGENT_BUDGET_USD=2.00
# Separate stores: the local payment service and persistent agent memory
EXPLAIN_PAYMENTS_DB=.explain-agent/payments.db
EXPLAIN_MEMORY_DB=.explain-agent/memory.db
